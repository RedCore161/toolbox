# Copy to .env and adjust.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_PORT=8000

POSTGRES_DB=toolbox
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox

# Speech to text: comma-separated lang=model pairs from https://alphacephei.com/vosk/models
# (baked into the image at build time - rebuild after changing).
VOSK_MODELS=de=vosk-model-small-de-0.15,en=vosk-model-small-en-us-0.15
STT_DEFAULT_LANGUAGE=de

# Vision: 2B needs ~5 GB weights + ~2 GB peak during mask decoding (runs on 6 GB with some spill to shared RAM).
# float16 for GTX 16xx / RTX 20xx; bfloat16 on Ampere+ (RTX 30xx and newer); 4B with >= 12 GB VRAM.
WEVIS_MODEL=tencent/WeVisOne-VL-2B
WEVIS_DEVICE=auto
WEVIS_DTYPE=float16
# Pixel budget for the VLM input (768x512). Higher = slower, barely better masks (IoU 0.978 vs 1M px).
WEVIS_MAX_PIXELS=393216
# Instances decoded at once; each needs ~1.3 GB VRAM.
WEVIS_DECODER_BATCH_SIZE=1
# Optional - the model is public. A token only gives higher Hugging Face download rate limits.
HF_TOKEN=
